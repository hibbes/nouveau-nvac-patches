--- a/drivers/gpu/drm/nouveau/nvkm/engine/fifo/nv04.c
+++ b/drivers/gpu/drm/nouveau/nvkm/engine/fifo/nv04.c
@@ -327,11 +327,28 @@
 
 	if (!(pull0 & 0x00000100) ||
 	    !nv04_fifo_swmthd(device, chid, mthd, data)) {
+		u32 subc = (mthd >> 13) & 7;
+		u32 addr = mthd & 0x1ffc;
+		const char *name;
+
 		chan = nvkm_chan_get_chid(&fifo->engine, chid, &flags);
-		nvkm_error(subdev, "CACHE_ERROR - "
-			   "ch %d [%s] subc %d mthd %04x data %08x\n",
-			   chid, chan ? chan->name : "unknown",
-			   (mthd >> 13) & 7, mthd & 0x1ffc, data);
+		name = chan ? chan->name : "unknown";
+
+		/*
+		 * Mesa issues a method-0x0060 / data-0xbeef02xx binding
+		 * probe that lands here on every session start.  It is
+		 * harmless and recovers cleanly, so log it at debug level
+		 * and keep error level for the real thing.  The test is on
+		 * the method and data pattern alone, so it applies to every
+		 * chip that reaches this handler.
+		 */
+		if (addr == 0x0060 && (data & 0xffffff00) == 0xbeef0200)
+			nvkm_debug(subdev, "CACHE_ERROR - ch %d [%s] subc %d mthd %04x data %08x\n",
+				   chid, name, subc, addr, data);
+		else
+			nvkm_error(subdev, "CACHE_ERROR - ch %d [%s] subc %d mthd %04x data %08x\n",
+				   chid, name, subc, addr, data);
+
 		nvkm_chan_put(&chan, flags);
 	}
 
