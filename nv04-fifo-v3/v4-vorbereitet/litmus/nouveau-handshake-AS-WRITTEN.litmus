C nouveau-handshake-AS-WRITTEN

(*
 * The handover in 2von4-handschlag.diff, exactly as written.
 *
 * x = chan->killed
 * y = fctx->ready
 *
 * P0 = nouveau_channel_kill()          (diff lines 9,20,23)
 *      store x, smp_mb(), load y
 *
 * P1 = nouveau_fence_context_arm()     (diff lines 71,72)
 *      load x, THEN store y     <-- wrong way round for a handover
 *      (spin_lock_irqsave/spin_unlock_irqrestore around it omitted:
 *       P0 never takes that lock on this path, so it cannot order
 *       anything between the two threads.)
 *
 * exists = both sides miss each other = the kill is lost.
 * Expected result: Sometimes.  This is NOT SB; there is no cycle to
 * forbid, so no number of barriers on either side can make it Never.
 *)

{}

P0(int *x, int *y)
{
	int r0;

	WRITE_ONCE(*x, 1);
	smp_mb();
	r0 = READ_ONCE(*y);
}

P1(int *x, int *y)
{
	int r1;

	r1 = READ_ONCE(*x);
	WRITE_ONCE(*y, 1);
}

exists (0:r0=0 /\ 1:r1=0)
