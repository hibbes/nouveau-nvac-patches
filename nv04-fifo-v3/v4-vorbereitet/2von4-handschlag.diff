+/*
+ * Declare a finished fence context killable.
+ *
+ * A channel is schedulable, and its kill event armed, before its fence
+ * context exists, so a kill can arrive while the caller is still building
+ * one.  This and nouveau_channel_kill() hand over through chan->killed and
+ * fctx->ready: each stores its own flag before loading the other's, so at
+ * least one of them observes the other and the kill is not lost.  Both
+ * observing it is harmless, nouveau_fence_context_kill() only walks a list
+ * the first caller has already emptied.
+ *
+ * fctx->lock is held across the handover so that a kill arriving in the
+ * middle of it waits in nouveau_fence_context_kill(), which takes the same
+ * lock, instead of walking a context that is not finished.
+ */
+void
+nouveau_fence_context_arm(struct nouveau_channel *chan)
+{
+	struct nouveau_fence_chan *fctx = chan->fence;
+	unsigned long flags;
+	bool killed;
+
+	spin_lock_irqsave(&fctx->lock, flags);
+	killed = atomic_read(&chan->killed);
+	atomic_set(&fctx->ready, 1);
+	spin_unlock_irqrestore(&fctx->lock, flags);
+
+	if (killed)
+		nouveau_fence_context_kill(fctx, -ENODEV);
+}
