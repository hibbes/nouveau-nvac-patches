+/*
+ * Publish a freshly built fence context to nouveau_channel_kill().
+ *
+ * A channel is schedulable, and the kill event is armed, well before its
+ * fence context exists, so a kill can land while this function's caller is
+ * still building one.  The two sides agree through fctx->ready and
+ * chan->killed: each stores its own flag, issues a full barrier, then loads
+ * the other's.  Store-buffer ordering guarantees that at least one of them
+ * observes the other, so the kill is never lost.  Both observing it is fine,
+ * nouveau_fence_context_kill() is idempotent.
+ *
+ * fctx->ready cannot be replaced by a test of chan->fence: the fence
+ * backends publish that pointer before nouveau_fence_context_new()
+ * initialises fctx->lock, so it goes non-NULL while the context is still
+ * unusable.
+ */
+void
+nouveau_fence_context_arm(struct nouveau_channel *chan)
+{
+	struct nouveau_fence_chan *fctx = chan->fence;
+
+	WRITE_ONCE(fctx->ready, 1);
+	smp_mb(); /* pairs with the barrier in nouveau_channel_kill() */
+	if (atomic_read(&chan->killed))
+		nouveau_fence_context_kill(fctx, -ENODEV);
+}
