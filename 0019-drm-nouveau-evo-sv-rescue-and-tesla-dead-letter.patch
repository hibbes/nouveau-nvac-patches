+/* Patch 0019: synthesise the missing SV1 supervisor handshake (nv50 only). */
+static int
+nvkm_disp_chan_mthd_sv_kick(struct nvkm_disp_chan *chan, void *argv, u32 argc)
+{
+	union {
+		struct nvif_disp_chan_sv_kick_v0 v0;
+	} *args = argv;
+	int ret = -ENOSYS;
+
+	if (!(ret = nvif_unpack(ret, &argv, &argc, args->v0, 0, 0, false))) {
+		if (args->v0.mode > 1)
+			return -EINVAL;
+		/* nv50-family only: register layout 0x610024/0x610030. */
+		if (chan->disp->func->super != nv50_disp_super)
+			return -ENODEV;
+		return nv50_disp_sv_rescue(chan->disp, args->v0.mode);
+	}
+	return ret;
+}
