+/* Patch 0020b: failsafe timeout for the nonblocking commit-tail fence wait.
+ * drm_atomic_helper_wait_for_fences(..., false) waits uninterruptible and
+ * without timeout; a killed channel whose fences never signal (see 0020a)
+ * would hang the commit worker forever.  Bound the wait, then flip anyway
+ * and loudly warn.  timeout 0 = exact upstream behaviour. */
+static void
+nv50_disp_atomic_wait_for_fences(struct drm_device *dev,
+				 struct drm_atomic_state *state)
+{
+	struct nouveau_drm *drm = nouveau_drm(dev);
+	struct drm_plane_state *new_plane_state;
+	struct drm_plane *plane;
+	long ret;
+	int i;
+
+	if (!nouveau_disp_fence_timeout_ms) {
+		drm_atomic_helper_wait_for_fences(dev, state, false);
+		return;
+	}
+
+	for_each_new_plane_in_state(state, plane, new_plane_state, i) {
+		if (!new_plane_state->fence)
+			continue;
+		WARN_ON(!new_plane_state->fb);
+		ret = dma_fence_wait_timeout(new_plane_state->fence, false,
+			msecs_to_jiffies(nouveau_disp_fence_timeout_ms));
+		if (ret <= 0)
+			NV_WARN(drm, "plane %s: fence %llu:%llu wait %s (%ld), "
+				"flipping anyway; unsignalled-fence leak, please report\n",
+				plane->name, new_plane_state->fence->context,
+				(u64)new_plane_state->fence->seqno,
+				ret ? "failed" : "timed out", ret);
+		dma_fence_put(new_plane_state->fence);
+		new_plane_state->fence = NULL;
+	}
+}
