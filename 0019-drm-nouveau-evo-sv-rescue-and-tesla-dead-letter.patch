+/* Patch 0019: supervisor-handshake rescue (MCP79 EVO-wedge prevention).
+ * Park signature (5/5 of all wedges): a core UPDATE is accepted (err tracker
+ * 0x080/0x200), 0x610030 carries the extra 0x010 bit over the base state, but
+ * intr1 (0x610024) never latches the SV1 bit; the worker never runs, the
+ * unconditional continue (0x610030 = 0x80000000) is never written, the UPDATE
+ * never completes.  Deliver exactly what the missing IRQ would have done
+ * (mirror of the intr1 0x70 block in nv50_disp_intr).  mode 0 logs only. */
+int
+nv50_disp_sv_rescue(struct nvkm_disp *disp, u8 mode)
+{
+	struct nvkm_subdev *subdev = &disp->engine.subdev;
+	struct nvkm_device *device = subdev->device;
+	struct nvkm_head *head;
+	u32 intr0, intr1, en, en2, super;
+	int i;
+
+	intr0 = nvkm_rd32(device, 0x610020);
+	intr1 = nvkm_rd32(device, 0x610024);
+	en    = nvkm_rd32(device, 0x61002c);
+	en2   = nvkm_rd32(device, 0x610028);
+	super = nvkm_rd32(device, 0x610030);
+
+	nvkm_error(subdev, "sv-rescue probe: intr0 %08x intr1 %08x en %08x/%08x"
+		   " super %08x pending %08x busy %d\n", intr0, intr1, en, en2,
+		   super, disp->super.pending, work_busy(&disp->super.work));
+	for (i = 0; i < 3; i++)		/* core, base-0, base-1 */
+		nvkm_error(subdev, "sv-rescue: ch%d err %08x/%08x ctrl %08x\n",
+			   i, nvkm_rd32(device, 0x610080 + i * 8),
+			      nvkm_rd32(device, 0x610084 + i * 8),
+			      nvkm_rd32(device, 0x610200 + i * 0x10));
+	list_for_each_entry(head, &disp->heads, head) {
+		u16 h0 = 0, v0 = 0, h1 = 0, v1 = 0;
+		if (!head->func->rgpos)
+			continue;
+		head->func->rgpos(head, &h0, &v0);
+		usleep_range(1000, 1500);
+		head->func->rgpos(head, &h1, &v1);
+		nvkm_error(subdev, "sv-rescue: head-%d rgpos %u,%u -> %u,%u\n",
+			   head->id, h0, v0, h1, v1);
+	}
+
+	if (mode == 0)
+		return 0;
+
+	/* Quad guard: never touch a live SV path. */
+	if (intr1 & 0x00000070)
+		return -EBUSY;		/* a real SV IRQ is latched */
+	if (work_busy(&disp->super.work))
+		return -EBUSY;		/* worker queued or running */
+	if (!(super & 0x00000010))
+		return -ENODATA;	/* no frozen SV1 request */
+	for (i = 0; i < 2; i++) {	/* persistence: signature must hold */
+		usleep_range(2000, 3000);
+		if ((nvkm_rd32(device, 0x610024) & 0x70) ||
+		    !(nvkm_rd32(device, 0x610030) & 0x10))
+			return -EBUSY;
+	}
+
+	nvkm_error(subdev, "sv-rescue: synthesizing SV1 (super %08x)\n", super);
+	/* Finalise under super.mutex: nv50_disp_super holds it for its whole run,
+	 * so a real supervisor pass cannot execute a wrong phase while we set
+	 * pending.  Recheck the guards once serialised. */
+	if (!mutex_trylock(&disp->super.mutex))
+		return -EBUSY;
+	if ((nvkm_rd32(device, 0x610024) & 0x00000070) ||
+	    work_busy(&disp->super.work) ||
+	    !(nvkm_rd32(device, 0x610030) & 0x00000010)) {
+		mutex_unlock(&disp->super.mutex);
+		return -EBUSY;
+	}
+	disp->super.pending = 0x00000010;
+	queue_work(disp->super.wq, &disp->super.work);
+	nvkm_wr32(device, 0x610024, 0x00000010);	/* W1C, no-op if never latched */
+	mutex_unlock(&disp->super.mutex);
+	return 0;
+}
+
