+ * mapped from here: drm_panic calls ->get_scanout_buffer() under
+ * drm_panic_trylock(), a raw spinlock taken with interrupts disabled.
+ */
+static bool
+nv50_wndw_panic_map(struct nouveau_bo *nvbo, struct iosys_map *map)
+{
+	if (!nvbo->kmap.virtual)
+		return false;
+
+	if (!(nvbo->kmap.bo_kmap_type & TTM_BO_MAP_IOMEM_MASK)) {
+		iosys_map_set_vaddr(map, nvbo->kmap.virtual);
+		return true;
