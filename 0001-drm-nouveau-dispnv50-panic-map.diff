+/* Pin a buffer and set up a CPU mapping of it, both under the same
+ * reservation, and keep the mapping alive for as long as this pin lasts.
+ *
+ * For callers that need to touch the buffer from a context where mapping it
+ * is not possible - drm_panic runs its ->get_scanout_buffer() callback under
+ * a raw spinlock with interrupts disabled, where ttm_bo_reserve() must not
+ * sleep and ioremap() BUG()s.
+ */
+int
+nouveau_bo_pin_map(struct nouveau_bo *nvbo, uint32_t domain, bool contig)
+{
+	struct ttm_buffer_object *bo = &nvbo->bo;
+	int ret;
+
+	ret = ttm_bo_reserve(bo, false, false, NULL);
+	if (ret)
+		return ret;
+
+	ret = nouveau_bo_pin_locked(nvbo, domain, contig);
+	if (ret)
+		goto out;
+
+	/* nouveau_bo.kmap is a single slot without a refcount, and
+	 * ttm_bo_kmap() overwrites it without looking, so only map if it is
+	 * free. The only other user that can have a mapping in there is the
+	 * pushbuf path, and it drops it before releasing the reservation
+	 * (nouveau_gem.c, validate_fini_no_ticket()), so holding the
+	 * reservation here means the slot is either ours or unused.
+	 */
+	if (!nvbo->kmap.virtual) {
+		ret = ttm_bo_kmap(bo, 0, PFN_UP(bo->base.size), &nvbo->kmap);
+		if (ret) {
+			nouveau_bo_unpin_locked(nvbo);
+			goto out;
+		}
+
+		nvbo->kmap_bus_offset = bo->resource->bus.offset;
+	}
+
+out:
+	ttm_bo_unreserve(bo);
+	return ret;
+}
+
+void
+nouveau_bo_unpin_unmap(struct nouveau_bo *nvbo)
+{
+	struct ttm_buffer_object *bo = &nvbo->bo;
+
+	if (ttm_bo_reserve(bo, false, false, NULL))
+		return;
+
+	nouveau_bo_unpin_locked(nvbo);
+	if (!bo->pin_count) {
+		ttm_bo_kunmap(&nvbo->kmap);
+		nvbo->kmap_bus_offset = 0;
+	}
+
+	ttm_bo_unreserve(bo);
+}
