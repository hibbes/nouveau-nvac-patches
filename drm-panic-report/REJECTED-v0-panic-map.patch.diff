+/* The CPU mapping of a buffer object is a shared singleton, not something
+ * each user gets a private copy of: TTM asks the driver to set up the aperture
+ * only for the first mapping of a resource (ttm_mem_io_reserve() returns early
+ * once ttm_resource.bus is populated), but it asks the driver to tear it down
+ * on every ttm_bo_kunmap()/ttm_bo_vunmap(), and nouveau_ttm_io_mem_free_locked()
+ * then drops the BAR1 window unconditionally.  A second ttm_bo_kmap() of the
+ * same buffer object therefore does not create a second mapping, it creates a
+ * second owner of the first one, and the first teardown leaves every other
+ * owner pointing into a BAR1 window that has since been handed to someone else.
+ *
+ * Funnel all kernel mappings of a nouveau buffer object through nvbo->kmap and
+ * count them here.  Callers must hold the buffer object reservation.  A
+ * mapping that outlives the reservation additionally requires the buffer
+ * object to be pinned, so that ttm_bo_kunmap() sees the same ttm_resource that
+ * ttm_bo_kmap() saw.
+ */
+int
+nouveau_bo_map_locked(struct nouveau_bo *nvbo)
+{
+	int ret;
+
+	dma_resv_assert_held(nvbo->bo.base.resv);
+
+	if (nvbo->kmap_count) {
+		nvbo->kmap_count++;
+		return 0;
+	}
+
+	/* nouveau_ttm_io_mem_reserve() reclaims BAR1 space by tearing down the
+	 * io mapping of whatever is at the head of the io_reserve_lru, without
+	 * asking the users of that mapping.  Keep mapped objects off the list.
+	 */
+	nouveau_bo_del_io_reserve_lru(&nvbo->bo);
+
+	ret = ttm_bo_kmap(&nvbo->bo, 0, PFN_UP(nvbo->bo.base.size), &nvbo->kmap);
+	if (ret)
+		return ret;
+
+	nvbo->kmap_count = 1;
+	return 0;
+}
+
+void
+nouveau_bo_unmap_locked(struct nouveau_bo *nvbo)
+{
+	dma_resv_assert_held(nvbo->bo.base.resv);
+
+	/* Tolerate an unmap of an object that was never mapped, ttm_bo_kunmap()
+	 * used to do the same and callers such as nv04_display_fini() rely on
+	 * it.
+	 */
+	if (!nvbo->kmap_count || --nvbo->kmap_count)
+		return;
+
+	ttm_bo_kunmap(&nvbo->kmap);
+}
+
 int
