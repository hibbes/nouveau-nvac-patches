 {
+	int ret;
+
 	if (!nvbo)
 		return;
 
-	ttm_bo_kunmap(&nvbo->kmap);
+	ret = ttm_bo_reserve(&nvbo->bo, false, false, NULL);
+	if (WARN_ON(ret))
+		return;
+
+	nouveau_bo_unmap_locked(nvbo);
+
+	ttm_bo_unreserve(&nvbo->bo);
 }
 
